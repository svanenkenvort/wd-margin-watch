# Copy to .env.local for running on your computer. On Vercel, set these under
# Project > Settings > Environment Variables instead (see DEPLOY.md). Never commit real values.

# Builder Prime (Admin > Integrations > Open API)
BUILDERPRIME_API_KEY=
BUILDERPRIME_SUBDOMAIN=windowdepotnew

# Sign-in. AUTH_SECRET: 32+ random characters, e.g. from `openssl rand -base64 48`.
AUTH_SECRET=
# The first admin. Only used while nobody has an account; can be removed after the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Database. Vercel sets this when you connect Neon. Leave empty locally to use data/store.json.
DATABASE_URL=
